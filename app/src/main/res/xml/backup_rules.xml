<?xml version="1.0" encoding="utf-8"?>
<!--
   Automatikus mentés szabályai Android 11 (API 30) és régebbi rendszereken.
   API 31+ esetén a data_extraction_rules.xml érvényes – a kettőt összhangban kell tartani.
   Csak az adatbázis (cashapp.db + WAL/SHM) és a DataStore beállítások kerülnek mentésre.
-->
<full-backup-content>
    <include domain="database" path="cashapp.db" />
    <include domain="database" path="cashapp.db-wal" />
    <include domain="database" path="cashapp.db-shm" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
