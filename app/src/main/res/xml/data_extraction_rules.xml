<?xml version="1.0" encoding="utf-8"?>
<!--
   Mentési szabályok Android 12 (API 31) és újabb rendszereken.
   Felhőmentés és eszközök közötti átvitel ugyanazt tartalmazza, mint a backup_rules.xml:
   az adatbázist (cashapp.db + WAL/SHM) és a DataStore beállításokat.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cashapp.db" />
        <include domain="database" path="cashapp.db-wal" />
        <include domain="database" path="cashapp.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cashapp.db" />
        <include domain="database" path="cashapp.db-wal" />
        <include domain="database" path="cashapp.db-shm" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
